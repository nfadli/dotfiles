{
  // font
  "editor.fontFamily": "'Iosevka Nerd Font', 'IosevkaTerm Nerd Font', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "errorLens.followCursor": "activeLine",
  //clean
  "chat.disableAIFeatures": true,
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  "editor.minimap.enabled": false,
  "workbench.startupEditor": "none",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.hideCursorInOverviewRuler": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.activityBar.location": "hidden",
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  //vim config
  "vim.useSystemClipboard": true,
  "vim.ignorecase": true,
  "vim.smartcase": false,
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-j>": false,
    "<C-f>": false
  },
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<CR>"],
      "commands": [
        {
          "command": "oil-code.select"
        }
      ]
    },
    {
      "before": ["-"],
      "commands": [
        {
          "command": "oil-code.openParent"
        }
      ]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["oil-code.open"]
    },
    {
      "before": ["<leader>", "r"],
      "commands": ["workbench.action.openRecent"]
    },
    {
      "before": ["<leader>", "b", "a"],
      "commands": ["workbench.action.closeOtherEditors"]
    },
    {
      "before": ["<leader>", "b"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<leader>", "n", "h"],
      "commands": [":nohlsearch", "notifications.clearAll"]
    }
  ],
  //oil config
  "oil-code.columns": ["icon", "permissions", "size", "mtime"],
  "oil-code.hasNerdFont": true,
  "oil-code.disableOpenCwdNothingOpen": true,
  //terminal keys
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.toggleTerminal",
    "-workbench.action.quickOpen",
    "-workbench.action.openRecent",
    "-workbench.action.reloadWindow",
    "-workbench.action.files.newUntitledFile",
    "-workbench.action.terminal.focusFind"
  ],
  //formatter
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true, // disable default behavior
  //rust
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  //clangd
  "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build"],
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  }
}
