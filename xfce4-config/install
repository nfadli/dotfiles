#!/bin/sh

if [ "$1" = "dark" ]; then
  THEME="adw-gtk3-dark"
  QT="adwaita-dark"
  DARK=1
  SCHEME="prefer-dark"
elif [ "$1" = "white" ]; then
  THEME="adw-gtk3"
  QT="adwaita"
  DARK=0
  SCHEME="default"
else
  echo "Penggunaan: $0 dark | white"
  exit 1
fi

# 1. Install tema ke ~/.local/share/themes
THEME_DIR="$HOME/.local/share/themes"
if [ ! -d "$THEME_DIR/$THEME" ]; then
  ARCHIVE=""
  [ -f "./adw-gtk3v6.5.tar.xz" ] && ARCHIVE="./adw-gtk3v6.5.tar.xz"
  [ -z "$ARCHIVE" ] && [ -f "$HOME/Downloads/adw-gtk3v6.5.tar.xz" ] && ARCHIVE="$HOME/Downloads/adw-gtk3v6.5.tar.xz"
  [ -z "$ARCHIVE" ] && {
    echo "Error: adw-gtk3v6.5.tar.xz tidak ditemukan!"
    exit 1
  }

  mkdir -p "$THEME_DIR"
  tar -xf "$ARCHIVE" -C "$THEME_DIR/"
fi

# 2. Setup Keyboard XFCE4 (~/.config/xfce4)
XML_SRC="./xfce4/xfconf/xfce-perchannel-xml"
XML_DEST="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
if [ -d "$XML_SRC" ]; then
  mkdir -p "$XML_DEST"
  for FILE in keyboards.xml xfce4-keyboard-shortcuts.xml; do
    [ -f "$XML_SRC/$FILE" ] && cp "$XML_SRC/$FILE" "$XML_DEST/"
  done
  pkill -HUP xfconfd 2>/dev/null
fi

# 3. Terapkan ke XFCE Desktop & Window Manager
xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "$THEME" 2>/dev/null || xfconf-query -c xsettings -p /Net/ThemeName -s "$THEME"
xfconf-query -c xfwm4 -p /general/theme -n -t string -s "$THEME" 2>/dev/null || xfconf-query -c xfwm4 -p /general/theme -s "$THEME"

# 4. GTK3, GTK4, & Preferensi Aplikasi (Firefox, Chromium, Electron, Libadwaita)
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
printf "[Settings]\ngtk-theme-name=%s\ngtk-application-prefer-dark-theme=%s\n" "$THEME" "$DARK" | tee "$HOME/.config/gtk-3.0/settings.ini" >"$HOME/.config/gtk-4.0/settings.ini"
ln -sfn "$THEME_DIR/$THEME/gtk-4.0/"* "$HOME/.config/gtk-4.0/"

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface gtk-theme "$THEME" 2>/dev/null
  gsettings set org.gnome.desktop.interface color-scheme "$SCHEME" 2>/dev/null
fi

# 5. Qt5 & Qt6 (hanya di ~/.config)
xbps-query adwaita-qt adwaita-qt6 qt5ct qt6ct >/dev/null 2>&1 || sudo xbps-install -Sy adwaita-qt adwaita-qt6 qt5ct qt6ct
mkdir -p "$HOME/.config/qt5ct" "$HOME/.config/qt6ct" "$HOME/.config/environment.d"
printf "[Appearance]\nstyle=%s\nstandard_dialogs=gtk3\n" "$QT" | tee "$HOME/.config/qt5ct/qt5ct.conf" >"$HOME/.config/qt6ct/qt6ct.conf"
printf "QT_QPA_PLATFORMTHEME=qt5ct\nQT_STYLE_OVERRIDE=%s\n" "$QT" >"$HOME/.config/environment.d/qt.conf"

# Tambah environment Qt ke sistem global (/etc/environment) agar terbaca di Void Linux tanpa mengotori $HOME
if ! grep -q "QT_QPA_PLATFORMTHEME=qt5ct" /etc/environment 2>/dev/null; then
  echo "QT_QPA_PLATFORMTHEME=qt5ct" | sudo tee -a /etc/environment >/dev/null
fi

echo "Selesai! Tema '$THEME' ($1), Qt '$QT', & Keyboard telah diterapkan."
