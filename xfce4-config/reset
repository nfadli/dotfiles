#!/bin/sh

echo "Memulai deep reset XFCE..."

# 1. Hentikan daemon konfigurasi XFCE agar tidak menulis ulang file lama ke disk
pkill -9 xfconfd 2>/dev/null

# 2. Hapus seluruh konfigurasi XFCE, GTK, Qt, dan cache sesi
rm -rf "$HOME/.config/xfce4" \
       "$HOME/.config/Thunar" \
       "$HOME/.config/autostart" \
       "$HOME/.config/gtk-3.0" \
       "$HOME/.config/gtk-4.0" \
       "$HOME/.config/qt5ct" \
       "$HOME/.config/qt6ct" \
       "$HOME/.config/environment.d/qt.conf" \
       "$HOME/.cache/sessions" \
       "$HOME/.cache/xfce4"

# 3. Hapus sisa tema lokal yang pernah diekstrak (opsional, hapus baris ini jika tema ingin disimpan)
rm -rf "$HOME/.local/share/themes/adw-gtk3"* \
       "$HOME/.themes/adw-gtk3"*

# 4. Salin ulang kerangka konfigurasi bawaan dari /etc/xdg (jika tersedia)
if [ -d "/etc/xdg/xfce4" ]; then
  mkdir -p "$HOME/.config"
  cp -r /etc/xdg/xfce4 "$HOME/.config/"
fi

echo "Reset selesai! Sesi akan ditutup otomatis dalam 3 detik..."
sleep 3

# 5. Keluar dari sesi XFCE agar perubahan termuat bersih saat login berikutnya
xfce4-session-logout --logout --fast 2>/dev/null || pkill -KILL -u "$USER"
