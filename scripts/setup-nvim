#!/usr/bin/env bash
#Ai generated
NVIM_URL="https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-linux-x86_64.tar.gz"
NVIM_TAR="/tmp/$(basename "$NVIM_URL")"

wget -c "$NVIM_URL" -O "$NVIM_TAR"
mkdir -p "$HOME/.local/bin" "$HOME/.local/lib" "$HOME/.local/share"

TMP_DIR=$(mktemp -d)
tar -xzf "$NVIM_TAR" -C "$TMP_DIR"
NVIM_DIR=$(find "$TMP_DIR" -mindepth 1 -maxdepth 1 -type d -name "nvim-*" | head -n 1)

cp -rf "$NVIM_DIR/bin/"* "$HOME/.local/bin/" 2>/dev/null || true
cp -rf "$NVIM_DIR/lib/"* "$HOME/.local/lib/" 2>/dev/null || true
cp -rf "$NVIM_DIR/share/"* "$HOME/.local/share/" 2>/dev/null || true
chmod +x "$HOME/.local/bin/nvim"
rm -rf "$TMP_DIR"
