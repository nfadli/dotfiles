#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG="$HOME/.config"
TARGET="$HOME/.themes"

mkdir -p "$TARGET"

# ==========================================
# DAFTAR TEMA YANG INGIN DI-INSTALL
# Cukup tambahkan nama file arsip (.tar.xz / .zip) di sini
# ==========================================
THEMES=(
	"adw-gtk3v6.5.tar.xz"
	"WhiteSur-Dark-solid.tar.xz"
	# Contoh jika nanti mau tambah tema lain:
	# "another-theme-v1.0.tar.xz"
)

# Loop untuk mengekstrak setiap tema secara otomatis
for ARCHIVE in "${THEMES[@]}"; do
	ARCHIVE_PATH="$DIR/$ARCHIVE"
	if [ -f "$ARCHIVE_PATH" ]; then
		echo " -> Mengekstrak tema: $ARCHIVE"
		tar -xf "$ARCHIVE_PATH" -C "$TARGET"
	else
		echo "Warning: Arsip $ARCHIVE tidak ditemukan di $DIR, dilewati."
	fi
done

# Tentukan tema utama yang aktif (bisa disesuaikan atau dibuat variabel)
ACTIVE_THEME="WhiteSur-Dark-solid"

# 1. Atur tema GTK & dekorasi jendela khusus Cinnamon
gsettings set org.cinnamon.desktop.interface gtk-theme "$ACTIVE_THEME"
gsettings set org.cinnamon.desktop.wm.preferences theme "$ACTIVE_THEME"
gsettings set org.x.apps.portal color-scheme 'prefer-dark'
gsettings set org.cinnamon.desktop.wm.preferences button-layout 'close,minimize,maximize:'

# 2. Skema GNOME/Portal untuk Flatpak/GTK4
gsettings set org.gnome.desktop.interface gtk-theme "$ACTIVE_THEME"
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# 3. Fallback konfigurasi GTK3/GTK4
for v in gtk-3.0 gtk-4.0; do
	mkdir -p "$CFG/$v"
	printf "[Settings]\ngtk-theme-name=%s\ngtk-application-prefer-dark-theme=1\n" "$ACTIVE_THEME" >"$CFG/$v/settings.ini"
done

# Load keybindings jika file-nya ada
if [ -f "$DIR/cinnamon-keybindings.conf" ]; then
	dconf load /org/cinnamon/desktop/keybindings/ <"$DIR/cinnamon-keybindings.conf"
fi

echo " -> Tema '$ACTIVE_THEME' berhasil dipasang!"
cinnamon-session-quit --logout --no-prompt
