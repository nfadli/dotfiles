#!/bin/sh
DIR=$(pwd)
ARCHIVE="adw-gtk3v6.5.tar.xz"
CFG="$HOME/.config"
TARGET="$HOME/.themes"

mkdir -p "$TARGET"
tar -xf "$DIR/$ARCHIVE" -C "$TARGET"

# 1. Atur tema GTK & dekorasi jendela khusus Cinnamon
gsettings set org.cinnamon.desktop.interface gtk-theme 'adw-gtk3-dark'
gsettings set org.cinnamon.desktop.wm.preferences theme 'adw-gtk3-dark'
gsettings set org.x.apps.portal color-scheme 'prefer-dark'

# 2. Opsional: Tetap set skema GNOME/Portal agar aplikasi Flatpak/GTK4 tahu mode gelap aktif
gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# 3. Fallback untuk aplikasi GTK3/GTK4 yang membaca file konfigurasi langsung
for v in gtk-3.0 gtk-4.0; do
	mkdir -p "$CFG/$v"
	printf "[Settings]\ngtk-theme-name=adw-gtk3-dark\ngtk-application-prefer-dark-theme=1\n" >"$CFG/$v/settings.ini"
done
dconf load /org/cinnamon/desktop/keybindings/ <cinnamon-keybindings.conf

echo " -> adw-gtk3-dark theme installed"
cinnamon-session-quit --logout --no-prompt
