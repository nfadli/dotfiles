#!/usr/bin/env bash
# Ai generated
set -euo pipefail

DIR="${2:-$(pwd)}"
PATH_DCONF="/org/cinnamon/desktop/keybindings/"
FILE="$DIR/keybindings.dconf"

case "${1:-}" in
backup)
  mkdir -p "$DIR"
  dconf dump "$PATH_DCONF" >"$FILE"
  echo "Backup saved to $FILE"
  ;;
restore)
  [[ -s "$FILE" ]] && dconf load "$PATH_DCONF" <"$FILE"
  echo "Restored from $FILE"
  ;;
*)
  echo "Usage: $0 {backup|restore} [dir]"
  exit 1
  ;;
esac
